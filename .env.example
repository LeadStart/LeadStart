# Supabase (local dev values from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Scrap.io API (Prospecting tab — lead enrichment).
# Production reads from organizations.scrapio_api_key, set per-org via
# /admin/settings/api. This env var is an optional fallback for the
# server-side search/typeahead routes when the org column is NULL — handy
# for local dev. The settings-page Test button always uses whatever key
# the user typed in, regardless of this env var.
SCRAPIO_API_KEY=your-scrapio-api-key

# Million Verifier (pre-send email verification).
# Production reads from organizations.millionverifier_api_key, set per-org via
# /admin/settings/api. This env var is an optional fallback for the
# run-native-sequences cron when the org column is NULL — handy for local dev.
# Leave unset to disarm the gate (sends proceed unverified). The settings-page
# Test button always uses whatever key the user typed in.
MILLIONVERIFIER_API_KEY=your-millionverifier-api-key

# Resend (for email reports)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=LeadStart <reports@yourdomain.com>

# Per-process Resend throttle (token bucket). Default 2 req/s — conservative
# against Resend's free-tier 2/s cap. Bump on paid plans (10/s standard).
RESEND_RATE_LIMIT_PER_SEC=2

# Webhook security
WEBHOOK_SECRET=your-random-secret-string

# Resend delivery webhook signing secret. Generated by Resend when you
# register an endpoint at https://resend.com/webhooks — starts with "whsec_".
# The handler at /app/api/webhooks/resend rejects every request with 401
# until this is populated, so ship is safe even before setup.
RESEND_WEBHOOK_SECRET=whsec_your_resend_signing_secret

# HMAC secret for signed portal deep-links sent in hot-lead notification
# emails (4h TTL, single-use). Rotating this invalidates every outstanding
# link. Generate: openssl rand -hex 32
URL_SIGNING_SECRET=generate-with-openssl-rand-hex-32

# Stripe (billing)
# Test keys in dev (sk_test_…, pk_test_…), live in prod.
# STRIPE_WEBHOOK_SECRET is printed by `stripe listen --forward-to .../api/webhooks/stripe`
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# App URL used for Stripe Checkout success/cancel URLs and quote-page links.
# Include the /app basePath. Defaults to http://localhost:3000/app in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000/app

# OPTIONAL — local dev auto-login. When set, navigating to /app/api/dev/login
# mints a session for this (already-existing) Supabase user and drops you in the
# dashboard, so you never type credentials into the local login form. The route
# is hard-gated to non-production (returns 404 whenever NODE_ENV=production), so
# this is a no-op on any deployed environment. Leave unset to disable.
# DEV_AUTOLOGIN_EMAIL=you@example.com
